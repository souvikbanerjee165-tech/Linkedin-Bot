# LinkedIn B2B Growth & Sales Copilot Environment Configuration

# Official DeepSeek API Key (Required for live AI generation)
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# API Base URL (defaults to official endpoint)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek Model: deepseek-chat or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# App Configuration
APP_ENV=production
DEBUG=false
